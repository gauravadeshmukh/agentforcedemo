        <fullName>Order_Information_Retrieval_16jg500000076ez</fullName>
        <canEscalate>true</canEscalate>
        <description>Handles user requests to retrieve order information based on a provided order number or Customer Authorized By</description>
        <developerName>Order_Information_Retrieval_16jg500000076ez</developerName>
        <genAiPluginInstructions>
            <description>Ask the user for their order number if it is not provided.</description>
            <developerName>instructions_0_1764016316852</developerName>
            <language>en_US</language>
            <masterLabel>instructions_0_1764016316852</masterLabel>
            <sortOrder>0</sortOrder>
        </genAiPluginInstructions>
        <genAiPluginInstructions>
            <description>Use the provided order number to search for the relevant order information.</description>
            <developerName>instruction_1</developerName>
            <language xsi:nil="true"/>
            <masterLabel>Instruction 1</masterLabel>
            <sortOrder>1</sortOrder>
        </genAiPluginInstructions>
        <genAiPluginInstructions>
            <description>If the order number is invalid or not found, inform the user and ask if they would like to try again or escalate to an agent.</description>
            <developerName>instruction_2</developerName>
            <language xsi:nil="true"/>
            <masterLabel>Instruction 2</masterLabel>
            <sortOrder>2</sortOrder>
        </genAiPluginInstructions>
        <genAiPluginInstructions>
            <description>Provide the retrieved order information to the user in a clear and concise manner.</description>
            <developerName>instruction_3</developerName>
            <language xsi:nil="true"/>
            <masterLabel>Instruction 3</masterLabel>
            <sortOrder>3</sortOrder>
        </genAiPluginInstructions>
        <genAiPluginInstructions>
            <description>If the user provides &apos;Customer Authorized By&apos; information instead of an order number, use it to search for the relevant order details and confirm the retrieved information with the user.</description>
            <developerName>instruction_4</developerName>
            <language xsi:nil="true"/>
            <masterLabel>Instruction 4</masterLabel>
            <sortOrder>4</sortOrder>
        </genAiPluginInstructions>
